rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Conversations
    match /conversations/{conversationId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        // More robust message rules: if you can see the conversation, you can see the messages
        allow read, write: if isSignedIn(); 
      }
    }

    // User Progress & Profile
    match /users/{userId} {
      match /progress/default {
        allow read, write: if isOwner(userId);
      }
      match /profile/default {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
